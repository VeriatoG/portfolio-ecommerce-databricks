    {
      "name": "comparativo_precos",
      "displayName": "Comparativo Precos",
      "config": {
        "source": "SELECT 'Nosso Preço' AS fonte_preco, preco_nosso AS preco, id_produto FROM projetoportfolio.gold.precos_competitividade\nUNION ALL\nSELECT 'Concorrentes (Médio)' AS fonte_preco, preco_medio_conc AS preco, id_produto FROM projetoportfolio.gold.precos_competitividade\n",
        "measures": [
          {
            "name": "preco_medio",
            "expr": "AVG(preco)",
            "displayName": "Preço Médio (R$)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "max",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Comparativo de preços concorrentes vs nosso preço - gold layer",
        "dimensions": [
          {
            "name": "fonte_preco",
            "expr": "fonte_preco",
            "displayName": "Fonte do Preço"
          },
          {
            "name": "id_produto",
            "expr": "id_produto",
            "displayName": "ID Produto"
          }
        ]
      }
    },
    {
      "name": "top_produtos_ord",
      "displayName": "Top Produtos Ordenado",
      "queryLines": [
        "SELECT\n",
        "  INITCAP(REPLACE(nome_produto, '_', ' ')) AS nome_produto,\n",
        "  CASE\n",
        "    WHEN receita >= 1000000000 THEN CONCAT(CAST(ROUND(receita / 1000000000, 1) AS STRING), 'B')\n",
        "    WHEN receita >= 1000000 THEN CONCAT(CAST(ROUND(receita / 1000000, 1) AS STRING), 'M')\n",
        "    WHEN receita >= 1000 THEN CONCAT(CAST(ROUND(receita / 1000, 1) AS STRING), 'K')\n",
        "    ELSE CAST(ROUND(receita) AS STRING)\n",
        "  END AS receita,\n",
        "  CASE\n",
        "    WHEN\n",
        "      total_vendas >= 1000000000\n",
        "    THEN\n",
        "      CONCAT(CAST(ROUND(total_vendas / 1000000000, 1) AS STRING), 'B')\n",
        "    WHEN total_vendas >= 1000000 THEN CONCAT(CAST(ROUND(total_vendas / 1000000, 1) AS STRING), 'M')\n",
        "    WHEN total_vendas >= 1000 THEN CONCAT(CAST(ROUND(total_vendas / 1000, 1) AS STRING), 'K')\n",
        "    ELSE CAST(total_vendas AS STRING)\n",
        "  END AS quantidade_total\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      nome_produto,\n",
        "      receita,\n",
        "      total_vendas\n",
        "    FROM\n",
        "      projetoportfolio.gold.vendas_produtos\n",
        "  ) t\n",
        "ORDER BY\n",
        "  t.receita DESC"
      ],
      "catalog": "projetoportfolio",
      "schema": "bronze"
    }
  ],
