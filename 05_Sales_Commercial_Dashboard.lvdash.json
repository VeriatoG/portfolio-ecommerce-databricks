{
  "datasets": [
    {
      "name": "vendas",
      "displayName": "Vendas",
      "config": {
        "version": "1.1",
        "source": "projetoportfolio.gold.vendas_temporais",
        "dimensions": [
          {
            "name": "data",
            "expr": "data",
            "displayName": "Data",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "canal_venda",
            "expr": "INITCAP(REPLACE(canal_venda, '_', ' '))",
            "displayName": "Canal de Venda"
          }
        ],
        "measures": [
          {
            "name": "receita",
            "expr": "SUM(receita)",
            "displayName": "Receita",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "num_vendas",
            "expr": "COUNT(1)",
            "displayName": "Numero de Vendas"
          }
        ]
      }
    },
    {
      "name": "clientes",
      "displayName": "Clientes",
      "config": {
        "version": "1.1",
        "source": "projetoportfolio.gold.clientes_segmentacao",
        "dimensions": [
          {
            "name": "id_cliente",
            "expr": "id_cliente",
            "displayName": "ID Cliente"
          },
          {
            "name": "nome_cliente",
            "expr": "nome_cliente",
            "displayName": "Nome do Cliente"
          },
          {
            "name": "regiao",
            "expr": "regiao",
            "displayName": "Regiao"
          },
          {
            "name": "estado",
            "expr": "estado",
            "displayName": "Estado"
          },
          {
            "name": "segmento",
            "expr": "segmento",
            "displayName": "Segmento"
          }
        ],
        "measures": [
          {
            "name": "num_clientes",
            "expr": "COUNT(id_cliente)",
            "displayName": "Numero de Clientes"
          },
          {
            "name": "ticket_medio",
            "expr": "AVG(ticket_medio)",
            "displayName": "Ticket Medio",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_gasto",
            "expr": "SUM(total_gasto)",
            "displayName": "Total Gasto",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_compras",
            "expr": "SUM(total_compras)",
            "displayName": "Total de Compras"
          }
        ]
      }
    },
    {
      "name": "preco_competidores",
      "displayName": "Preço dos Concorrentes",
      "config": {
        "version": "1.1",
        "source": "projetoportfolio.gold.precos_competitividade",
        "dimensions": [
          {
            "name": "id_produto",
            "expr": "id_produto",
            "displayName": "ID Produto"
          },
          {
            "name": "nome_produto",
            "expr": "nome_produto",
            "displayName": "Nome do Produto"
          },
          {
            "name": "marca",
            "expr": "marca",
            "displayName": "Marca"
          },
          {
            "name": "mais_caro_que_todos",
            "expr": "mais_caro_que_todos",
            "displayName": "Mais Caro Que Todos"
          }
        ],
        "measures": [
          {
            "name": "preco_nosso",
            "expr": "AVG(preco_nosso)",
            "displayName": "Preco Nosso",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "preco_min_conc",
            "expr": "MIN(preco_min_conc)",
            "displayName": "Preco Minimo Concorrente",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "preco_max_conc",
            "expr": "MAX(preco_max_conc)",
            "displayName": "Preco Maximo Concorrente",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "preco_medio_conc",
            "expr": "AVG(preco_medio_conc)",
            "displayName": "Preco Medio Concorrente",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_concorrentes",
            "expr": "SUM(total_concorrentes)",
            "displayName": "Total de Concorrentes"
          }
        ]
      }
    },
    {
      "name": "produtos",
      "displayName": "Produtos",
      "config": {
        "version": "1.1",
        "source": "projetoportfolio.gold.vendas_produtos",
        "dimensions": [
          {
            "name": "id_produto",
            "expr": "id_produto",
            "displayName": "ID Produto"
          },
          {
            "name": "nome_produto",
            "expr": "nome_produto",
            "displayName": "Nome do Produto"
          },
          {
            "name": "categoria",
            "expr": "categoria",
            "displayName": "Categoria"
          },
          {
            "name": "marca",
            "expr": "marca",
            "displayName": "Marca"
          }
        ],
        "measures": [
          {
            "name": "receita",
            "expr": "SUM(receita)",
            "displayName": "Receita",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_vendas",
            "expr": "SUM(total_vendas)",
            "displayName": "Total de Vendas"
          }
        ]
      }
    }
  ],
  "relationshipGraphs": [
    {
      "sources": [
        {
          "name": "Vendas",
          "datasetName": "vendas"
        },
        {
          "name": "Clientes",
          "datasetName": "clientes"
        },
        {
          "name": "Preo_dos_Concorrentes",
          "datasetName": "preco_competidores"
        },
        {
          "name": "Produtos",
          "datasetName": "produtos"
        }
      ],
      "relationships": [
        {
          "name": "relationship_2",
          "from": "Preo_dos_Concorrentes",
          "to": "Produtos",
          "on": "`Preo_dos_Concorrentes`.`id_produto` = `Produtos`.`id_produto`",
          "cardinality": "CARDINALITY_MANY_TO_ONE"
        }
      ]
    }
  ],
